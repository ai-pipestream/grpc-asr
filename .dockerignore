# Keep models/ IN the context on purpose: an image build then runs the
# real transcription tests inside the build stage. CI downloads
# ggml-tiny.en.bin (pinned revision, sha256-checked) and builds with
# GRPC_ASR_TEST_REQUIRE_MODELS=1, so a missing model fails there; a
# context without models and without that flag skips those tests (77).
build/
.git/
.cache/
