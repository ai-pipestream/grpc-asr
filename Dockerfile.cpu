# syntax=docker/dockerfile:1.26
# grpc-asr — CPU-only image. Same layout as the CUDA Dockerfile without
# the GGML CUDA backend; run it with GRPC_ASR_BACKEND=cpu (the backend is
# never silently substituted, so the default of cuda would refuse to boot
# in this image — the env below makes cpu the image's explicit choice).

FROM ubuntu:24.04 AS build
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates cmake g++ git make ninja-build pkg-config ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# The id carries ${TARGETARCH} because a multi-platform buildx build runs
# every platform concurrently and cache mounts are keyed by id alone: with a
# shared id both platforms mount the same /build and corrupt each other's
# CMake state and archives (mixed-arch or duplicated members in
# libggml-cpu.a, or a configure that reads the other platform's
# half-written CMakeCache). The r2 suffix retires the poisoned pre-split
# cache.
RUN --mount=type=cache,id=grpc-asr-ubuntu24-cpu-grpc1.83.0-whisper1.9.2-r2-${TARGETARCH},target=/build \
    cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON \
        -DGRPC_ASR_WERROR=ON -DGRPC_ASR_TEST_TIMEOUT=3000 \
    && cmake --build /build --target grpc-asr-server grpc-asr-tests --parallel \
    && ctest --test-dir /build -L asr --output-on-failure \
    && mkdir -p /out && cp /build/grpc-asr-server /out/

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/grpc-asr-server /usr/local/bin/grpc-asr-server

ENV GRPC_ASR_LISTEN_ADDRESS=0.0.0.0:50055 \
    GRPC_ASR_BACKEND=cpu \
    GRPC_ASR_MODELS_DIR=/models

USER 65532:65532
EXPOSE 50055
ENTRYPOINT ["/usr/local/bin/grpc-asr-server"]
