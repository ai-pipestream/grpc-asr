# Keep scalar depthwise accumulation fused in every build mode. The pinned
# source leaves contraction to compiler optimization, changing Parakeet output.
set(depthwise_source "${whisper_SOURCE_DIR}/ggml/src/ggml-cpu/ops.cpp")
file(READ "${depthwise_source}" depthwise_text)
set(depthwise_original "${depthwise_text}")
set(depthwise_old [=[                        sum += ggml_conv_2d_dw_knl_f32(knl_data, (knl_y * p.knl_w + knl_x) * c + c_i, knl_type)
                             * src_data[(src_y * p.src_w + src_x) * c + c_i];]=])
set(depthwise_new [=[                        sum = std::fma(ggml_conv_2d_dw_knl_f32(knl_data, (knl_y * p.knl_w + knl_x) * c + c_i, knl_type),
                                       src_data[(src_y * p.src_w + src_x) * c + c_i], sum);]=])
string(FIND "${depthwise_text}" "${depthwise_old}" depthwise_position)
if(NOT depthwise_position EQUAL -1)
  string(REPLACE "${depthwise_old}" "${depthwise_new}" depthwise_text "${depthwise_text}")
else()
  string(FIND "${depthwise_text}" "${depthwise_new}" depthwise_position)
  if(depthwise_position EQUAL -1)
    message(FATAL_ERROR "Pinned GGML depthwise patch 1 no longer matches")
  endif()
endif()
set(depthwise_old [=[                        sum += ggml_conv_2d_dw_knl_f32(knl_base, knl_offset + knl_y * p.knl_w + knl_x, knl_type)
                             * src_data[src_y * p.src_w + src_x];]=])
set(depthwise_new [=[                        sum = std::fma(ggml_conv_2d_dw_knl_f32(knl_base, knl_offset + knl_y * p.knl_w + knl_x, knl_type),
                                       src_data[src_y * p.src_w + src_x], sum);]=])
string(FIND "${depthwise_text}" "${depthwise_old}" depthwise_position)
if(NOT depthwise_position EQUAL -1)
  string(REPLACE "${depthwise_old}" "${depthwise_new}" depthwise_text "${depthwise_text}")
else()
  string(FIND "${depthwise_text}" "${depthwise_new}" depthwise_position)
  if(depthwise_position EQUAL -1)
    message(FATAL_ERROR "Pinned GGML depthwise patch 2 no longer matches")
  endif()
endif()
if(NOT depthwise_text STREQUAL depthwise_original)
  file(WRITE "${depthwise_source}" "${depthwise_text}")
endif()
